{
  "metadata": {
    "display_name": "API Aggregator",
    "desc": "Clean AstrBot WebUI plugin for managing and testing aggregated APIs."
  },
  "config": {
    "language_mode": {
      "description": "Language mode.",
      "hint": "auto follows the current AstrBot WebUI locale for the plugin page; backend trigger replies stay English in auto mode.",
      "labels": [
        "Auto",
        "Chinese",
        "English"
      ]
    },
    "default_timeout_seconds": {
      "description": "Default request timeout for newly created APIs, in seconds.",
      "hint": "Default 12, range 1-120. Individual APIs can still override this in the plugin page."
    },
    "response_read_limit_bytes": {
      "description": "Maximum upstream API response bytes to read.",
      "hint": "Default 4096, range 1-1048576. Higher values can parse larger JSON responses but increase memory, log, and WebUI preview pressure."
    },
    "test_log_limit": {
      "description": "Maximum number of test log entries to retain.",
      "hint": "Default 100, range 1-1000. Higher values increase the plugin data file size."
    },
    "preview_max_chars": {
      "description": "Maximum response preview characters in aggregate summary messages.",
      "hint": "Default 1200, range 1-10000. This only affects summary display and does not change the response read limit."
    },
    "proxy_mode": {
      "description": "External API request proxy mode.",
      "hint": "direct connects to the target API without a proxy; custom uses the proxy URL below; environment uses proxy settings from the AstrBot process environment.",
      "labels": [
        "Direct",
        "Custom Proxy",
        "Environment Proxy"
      ]
    },
    "proxy_url": {
      "description": "External API request proxy URL.",
      "hint": "Only used when proxy_mode is custom. Supports http:// and https://. If the scheme is omitted, http:// is used."
    }
  },
