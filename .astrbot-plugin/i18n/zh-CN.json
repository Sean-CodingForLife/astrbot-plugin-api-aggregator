{
  "metadata": {
    "display_name": "API Aggregator",
    "desc": "用于管理、测试和聚合外部 API 的 AstrBot 插件。"
  },
  "config": {
    "language_mode": {
      "description": "插件页语言模式。",
      "hint": "auto 会跟随 AstrBot WebUI 当前语言显示。",
      "labels": [
        "自动",
        "中文",
        "英文"
      ]
    },
    "default_timeout_seconds": {
      "description": "新建 API 时使用的默认请求超时秒数。",
      "hint": "默认 12，范围 1-120。单个 API 仍可在插件页单独覆盖。"
    },
    "response_read_limit_bytes": {
      "description": "单次请求最多读取的上游响应字节数。",
      "hint": "默认 4096，范围 1-1048576。调高后可以处理更大的 JSON 响应，但会增加内存、日志和预览压力。"
    },
    "test_log_limit": {
      "description": "保留的测试日志条数上限。",
      "hint": "默认 100，范围 1-1000。调高后会增加插件数据文件体积。"
    },
    "preview_max_chars": {
      "description": "聚合摘要中响应预览的最大字符数。",
      "hint": "默认 1200，范围 1-10000。只影响摘要展示，不改变实际读取上限。"
    },
    "proxy_mode": {
      "description": "外部 API 请求代理模式。",
      "hint": "direct 为直连，custom 使用下方代理地址，environment 使用 AstrBot 进程环境中的代理设置。",
      "labels": [
        "直连",
        "自定义代理",
        "环境代理"
      ]
    },
    "proxy_url": {
      "description": "自定义代理地址。",
      "hint": "仅在 proxy_mode 为 custom 时生效。支持 http:// 和 https://；省略协议时按 http:// 处理。"
    }
  },
